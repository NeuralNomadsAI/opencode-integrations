{
  "name": "scene.create_object",
  "domain": "scene",
  "description": "Create a primitive, camera, light, or empty in the active scene.",
  "kind": "host-operation",
  "risk": "write",
  "undoable": true,
  "legacy": "create_object",
  "args": {
    "primitive": {
      "type": "string",
      "description": "Primitive type to create.",
      "default": "CUBE",
      "enum": ["CUBE", "SPHERE", "CYLINDER", "CONE", "PLANE", "CIRCLE", "GRID", "EMPTY", "CAMERA", "LIGHT"]
    },
    "name": {
      "type": "string",
      "description": "Optional explicit object name. Blender still applies collision suffixes when needed."
    },
    "location": {
      "type": "array",
      "description": "Optional world-space location as [x, y, z].",
      "items": {
        "type": "number"
      }
    }
  },
  "execution": {
    "strategy": "host_operation",
    "method": "apply",
    "handler": "scene.create_object"
  }
}
