      "default": "Z"
    },
    "interpolation": {
      "type": "string",
      "default": "LINEAR"
    }
  },
  "execution": {
    "strategy": "host_operation",
    "method": "apply",
    "handler": "animation.create_turntable_animation"
  }
}
