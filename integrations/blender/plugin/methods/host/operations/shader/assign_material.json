{
  "name": "shader.assign_material",
  "domain": "shader",
  "description": "Assign an existing material to an object material slot.",
  "kind": "host-operation",
  "risk": "write",
  "undoable": true,
  "legacy": "assign_material",
  "args": {
    "object_name": {
      "type": "string",
      "required": true,
      "description": "Target object name."
    },
    "material_name": {
      "type": "string",
      "required": true,
      "description": "Material name to assign."
    },
    "slot_index": {
      "type": "integer",
      "description": "Material slot index to fill or overwrite.",
      "default": 0
    }
  },
  "execution": {
    "strategy": "host_operation",
    "method": "apply",
    "handler": "shader.assign_material"
  }
}
