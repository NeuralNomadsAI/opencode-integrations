{
  "name": "@neuralnomads/opencode-m365",
  "version": "0.2.0",
  "description": "OpenCode for Microsoft 365: direct Microsoft Graph tools and workflows.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode-integration",
    "opencode",
    "m365"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuralNomadsAI/opencode-integrations",
    "directory": "integrations/m365/plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
