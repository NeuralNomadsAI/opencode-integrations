      "plugin": "neuralnomads.blender",
      "rpc": "neuralnomads.blender",
      "summary": {
        "en": "Inspect and edit the scene open in Blender through the OpenCode Link add-on: bounded reads, atomic changes as one undo step, captures as images.",
